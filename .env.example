# AWS CloudSquad — Environment Configuration Example
# Copy this file to .env and configure for your environment.

# Database (PostgreSQL)
POSTGRES_USER=cloudsquad
POSTGRES_PASSWORD=cloudsquad123
POSTGRES_DB=cloudsquad_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://cloudsquad:cloudsquad123@postgres:5432/cloudsquad_db

# Cache & Event Bus (Redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Workflow Orchestrator (Temporal)
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=cloudsquad-mission-queue

# AWS Configuration
AWS_REGION=ap-southeast-1
AWS_DEFAULT_REGION=ap-southeast-1
AWS_PROFILE=default
# Optional: Set AWS credentials if not using IAM roles or ~/.aws/credentials
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
S3_BUCKET=cloudsquad-mission-artifacts

# Execution Safety & Modes
# DEPLOYMENT_MODE: dry-run | apply (default is dry-run for local development)
DEPLOYMENT_MODE=dry-run
# DEMO_MODE: true | false (when true, simulates external AWS APIs when credentials are not supplied)
DEMO_MODE=true

# AI Gateway Configuration
# LLM_PROVIDER: bedrock | openai | anthropic | deterministic
LLM_PROVIDER=deterministic
MODEL_ID=claude-3-5-sonnet-20241022
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Application Server
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Variables
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
